[Unit]
Description=VE Diagnostics ve-rag-mcp.service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/agentic-ai-vehicle-diagnostics
EnvironmentFile=/opt/agentic-ai-vehicle-diagnostics/.env
ExecStart=/opt/agentic-ai-vehicle-diagnostics/.venv/bin/python /opt/agentic-ai-vehicle-diagnostics/app/rag/n8n_mcp_server.py --transport sse
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
